# Konfigurasi PDFku Cloud Server (aaPanel / Linux VPS)

# Port Server
PORT=3001

# Tipe Database: 'mysql' (disarankan untuk produksi aaPanel) atau 'sqlite' (otomatis fallback)
DB_TYPE=mysql

# Kredensial MySQL Server (Sesuai dengan database yang dibuat di aaPanel)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pdfku_user
DB_PASSWORD=GantiDenganPasswordDatabaseAnda
DB_NAME=pdfku_db

# Keamanan Token JWT
JWT_SECRET=pdfku-secret-key-2026-vps-secure
